# Copy this file to `.env` and fill in real values. Never commit `.env`.
#
# Zero-friction database: the app auto-detects a connection string from
# POSTGRES_URL (Vercel/Neon integration) or DATABASE_URL. No manual Supabase
# connection strings required.

# --- App ---
# In production Vercel sets this automatically per deployment; override to
# https://aibizbd.com once the custom domain is attached.
NEXT_PUBLIC_APP_URL=http://localhost:3000

# --- Database (PostgreSQL) ---
# Vercel Postgres / Neon integration injects POSTGRES_URL automatically.
# For local dev or any Postgres host, set DATABASE_URL instead.
# DATABASE_URL=postgres://user:pass@host:5432/dbname
# Neon only: direct (non-pooled) URL, used automatically by `db:migrate` for DDL.
# POSTGRES_URL_NON_POOLING=postgres://user:pass@host/dbname

# --- Credential encryption ---
# 32-byte AES-256 key, base64-encoded. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# Generate a different key per environment and store it in Vercel.
ENCRYPTION_KEY=

# --- Fulfillment provider ---
# 'mock' (default, no external API needed) | 'prodseller'
FULFILLMENT_PROVIDER=mock
# ProdSeller v1 API (only needed when FULFILLMENT_PROVIDER=prodseller)
# Base URL defaults to https://prodseller.com/v1 when unset.
PRODSELLER_API_URL=https://prodseller.com/v1
# ProdSeller API key (starts with psk_). Sent as the X-API-Key header.
# Generate in the ProdSeller admin panel under "API Manager".
PRODSELLER_API_KEY=

# --- Payment provider ---
# 'mock' (default, dev-only fake gateway) | 'bkash' | 'binance'
PAYMENT_PROVIDER=mock
# bKash tokenized checkout sandbox (only needed when PAYMENT_PROVIDER=bkash)
BKASH_SANDBOX_BASE_URL=https://tokenized.sandbox.bka.sh/v1.2.0-beta
BKASH_SANDBOX_MERCHANT_ID=
BKASH_SANDBOT_USERNAME=
BKASH_SANDBOX_PASSWORD=
# Binance Pay merchant sandbox (only needed when PAYMENT_PROVIDER=binance)
BINANCE_PAY_API_URL=https://bpay.binanceapi.com
BINANCE_PAY_API_KEY=
BINANCE_PAY_API_SECRET=
# Shared secret used to authenticate the mock payment webhook (dev only)
MOCK_PAYMENT_SECRET=dev-mock-secret-change-me

# --- Delivery (email + admin alerts) ---
# Resend API key. When unset, delivery emails are logged to the console.
RESEND_API_KEY=
EMAIL_FROM=Ai Biz BD <orders@aibizbd.com>
# Telegram admin alerts. When unset, alerts are logged to the console.
TELEGRAM_BOT_TOKEN=
TELEGRAM_ADMIN_CHAT_ID=
